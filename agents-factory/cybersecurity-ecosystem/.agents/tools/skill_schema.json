{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SKILL Frontmatter Schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "minLength": 50
    },
    "domain": {
      "type": "string",
      "enum": ["cybersecurity"]
    },
    "subdomain": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2
    },
    "version": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "mitre_attack": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nist_csf": {
      "type": "array",
      "items": { "type": "string" }
    },
    "d3fend": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["name", "description", "domain", "subdomain", "tags"]
}
