{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WebCGILightingPipelineConfig",
  "description": "Configuración de referencia estándar para pipelines de iluminación y renderizado WebGL2/WebGPU",
  "pipeline": {
    "rendering_path": "DeferredPlus",
    "target_fps": 60,
    "max_draw_calls": 100,
    "max_texture_memory_mb": 512,
    "dpr_limits": {
      "min": 1.0,
      "max": 2.0,
      "adaptive": true
    }
  },
  "lighting": {
    "environment": {
      "type": "HDRI_IBL",
      "spherical_harmonics": true,
      "intensity": 1.0,
      "rotation": 0.0
    },
    "directional_lights": [
      {
        "id": "sun_main",
        "color": "#FFF5E6",
        "intensity": 2.5,
        "cast_shadows": true,
        "shadow_map_resolution": 2048,
        "shadow_bias": -0.0001,
        "shadow_type": "PCSS",
        "cascade_count": 3
      }
    ],
    "ambient_occlusion": {
      "enabled": true,
      "technique": "GTAO",
      "radius": 0.5,
      "intensity": 1.2
    }
  },
  "post_processing": {
    "tone_mapping": "ACESFilmic",
    "exposure": 1.1,
    "bloom": {
      "enabled": true,
      "threshold": 0.85,
      "strength": 0.4,
      "radius": 0.5
    },
    "color_grading": {
      "enabled": true,
      "contrast": 1.05,
      "saturation": 0.95
    }
  }
}
