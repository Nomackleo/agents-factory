#!/usr/bin/env python3
"""
Graphify - Herramienta transversal de renderizado arquitectónico.
Extrae la topología de la base de datos relacional (Codebase-Memory-MCP) o consume diccionarios C4
para renderizar gráficos de arquitectura. Es portable y agnóstica al entorno.
"""
import sys
import os
import argparse
import sqlite3

# Determinar rutas relativas para portabilidad
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
PLUGINS_DIR = os.path.join(SCRIPT_DIR, '..', 'agents-factory', 'docs-as-code-ecosystem', 'plugins')

def render_architecture(ecosystem_name=None, max_depth=3):
    print("=========================================================")
    print(f" Graphify Builder - Renderizado C4/Mermaid")
    if ecosystem_name:
         print(f" Filtro Ecosistema: {ecosystem_name}")
    print(f" Filtro Profundidad Máxima: {max_depth}")
    print("=========================================================")
    
    db_path = os.path.join(SCRIPT_DIR, '..', 'mcp', 'codebase-memory-mcp', 'data', 'codebase_memory.sqlite')
    if not os.path.exists(db_path):
        print("[ERROR] Base de datos no encontrada.")
        return
        
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()
    
    # Si hay filtro, buscar por ecosystem. Si no, traer todo.
    if ecosystem_name:
        cursor.execute("SELECT file_path, ecosystem, description FROM codebase_index WHERE ecosystem=?", (ecosystem_name,))
    else:
        cursor.execute("SELECT file_path, ecosystem, description FROM codebase_index")
    
    nodes = cursor.fetchall()
    
    if ecosystem_name:
        cursor.execute("""
            SELECT source_file, target_file, relation_type 
            FROM file_relations 
            WHERE source_file LIKE ? OR target_file LIKE ?
        """, (f"%{ecosystem_name}%", f"%{ecosystem_name}%"))
    else:
        cursor.execute("SELECT source_file, target_file, relation_type FROM file_relations")
        
    relations = cursor.fetchall()
    conn.close()
    
    # Construir grafo Mermaid genérico filtrado por profundidad
    print("\n```mermaid")
    print("graph TD")
    
    # Filtrar Nodos por profundidad
    node_map = {}
    valid_nodes_count = 0
    for i, (fpath, eco, desc) in enumerate(nodes):
        depth = fpath.count('/')
        if depth <= max_depth:
            node_id = f"node_{i}"
            node_map[fpath] = node_id
            safe_name = os.path.basename(fpath)
            if safe_name == "README.md":
                safe_name = os.path.basename(os.path.dirname(fpath))
                if not safe_name or safe_name == ".":
                    safe_name = "Global_README"
            safe_name = safe_name.replace('"', '').replace(' ', '_')
            print(f'    {node_id}["{safe_name}"]:::ecosystemNode')
            valid_nodes_count += 1
            
    if valid_nodes_count == 0:
        print("    empty[\"No nodes found within the specified depth\"]")
        
    # Relaciones
    for src, tgt, rel in relations:
        if src in node_map and tgt in node_map:
            print(f'    {node_map[src]} -->|{rel}| {node_map[tgt]}')
            
    print('    classDef ecosystemNode fill:#1E293B,stroke:#3B82F6,stroke-width:1px,color:#F8FAFC')
    print("```\n")
    print(f"[EXITO] Renderizado arquitectónico completado ({valid_nodes_count} nodos mostrados).")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description='Graphify - Render architecture diagrams from SQLite memory.')
    parser.add_argument('--ecosystem', type=str, help='Filter by a specific ecosystem name', default=None)
    parser.add_argument('--max-depth', type=int, help='Maximum folder depth to render (prevents massive graphs)', default=3)
    
    args = parser.parse_args()
    render_architecture(args.ecosystem, args.max_depth)
